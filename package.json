{
  "name": "sofia-kindergartens",
  "private": true,
  "version": "1.0.0",
  "description": "A friendly way to browse, search and compare Sofia municipal kindergartens.",
  "type": "module",
  "workspaces": [
    "database",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "sync": "npm run sync -w backend",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5"
  }
}
